    {
      "addr": 2560,
      "name": "install",
      "title": "Install the resident joystick driver",
      "description": "Point BYTEV at the OSBYTE intercept at &0A0D. Called from\nthe BASIC via CALL &A00, after it has saved the previous BYTEV (line 50) and\npatched the chain slot (line 1840) and sensitivity thresholds (line 1850)."
    },
    {
      "addr": 2573,
      "name": "osbyte_intercept",
      "title": "BYTEV handler: map the joystick and keypad to INKEY",
      "description": "As variant A, but joystick_map entries >= &10 test the\nDelta 14B keypad matrix through the User VIA instead of an analogue channel."
    },
    {
      "addr": 2620,
      "name": "read_input",
      "title": "Test one joystick or keypad input",
      "description": "For the matched entry: entries below &10 read an analogue\nchannel (OSBYTE &80 / ADVAL) against the thresholds; entries >= &10 strobe a\nkeypad column through User VIA port B and test a row bit. A hit sets\nresult_flag."
    }
  ],
